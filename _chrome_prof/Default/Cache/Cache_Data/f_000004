/* ==================================================================
   极地 · 极光冰原 · /profile/ v5「Aurora」样式（页面在 /profile/，文件名沿用 clouds）
   ------------------------------------------------------------------
   北极极夜 + 极光幕 + 冰原的纯风景场景，DOM 层代码自研。
   cl- 前缀自成体系，与 .pf-* / .ld-* 零重叠。
   （v1 绘画化云海 → .workbuddy/clouds-v1-backup/
     v2 霓虹隧道奔跑者 → .workbuddy/clouds-v2-backup/）

   ⚠️ 渐进增强（本项目头号坑：CSS 默认隐藏 → 脚本没跑整页空白）：
     · 默认态 = 普通文档流：四幕依次排开各占一屏，纯 CSS 极夜渐变兜底，
       无 JS 也能完整阅读（WebGL 只是增强）。
     · .cl.js-on（clouds.js 第一时间加）才切换为 fixed 叠层 + 虚拟滚动，
       body.cl-lock 锁掉原生滚动。
     · 闸门同理：默认 display:none，js-on 下才出现。
   ================================================================== */

/* ---------- 字体：Miama（自托管，SIL OFL 1.1，可商用）----------
   Miama (c) 2008-2010 Linus Romer, with Reserved Font Name Miama.
   全文见 /fonts/miama/LICENSE.txt。设计者原话：Miama 基于他女友的大量
   手写信件，笔画相连 —— 不要改字距，改了连笔就断。
   ⚠️ 它 x-height 极小、升降部极长，只在 60px+ 的展示尺寸才好看，
      所以只给第一幕大标题用，正文一律不用。
   只加载 latin 子集（16KB）+ 完整 woff 兜底，不引外部 CDN。 */
@font-face {
  font-family: 'Miama';
  /* 字形本身自带斜势（原件即斜体），这里声明 normal ——
     若声明 italic 浏览器会再合成一次倾斜，笔画会糊。 */
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('../fonts/miama/miama-latin-basic-400.woff2') format('woff2'),
       url('../fonts/miama/Miama-Regular.woff') format('woff');
}

/* ---------- 字体：Press Start 2P（自托管，SIL OFL 1.1，可商用）----------
   8-bit 像素字体，作者 CodeMan38 / Press Start 2P Project Authors。
   闸门里 LOADING... 的像素感就来自它。原版 demo 是从 Google Fonts 引的，
   这里改成**自托管**（只取 latin 子集，12KB，走同域 /fonts/）——
   国内访问 Google Fonts 不稳定，外部字体请求还会拖慢首屏。
   全文见 /fonts/press-start-2p/LICENSE.txt。
   ⚠️ 这是 8×8 像素网格字体：font-size 用 8 的整数倍（16px）时每格正好
      落在整数物理像素上，边缘最锐；改了字号可能糊。 */
@font-face {
  font-family: 'Press Start 2P';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('../fonts/press-start-2p/press-start-2p-latin-400.woff2') format('woff2');
}

.cl {
  /* ---- 色板（极地：极夜黑 → 夜雾蓝 → 冰蓝；极光绿/冰蓝/极光紫）---- */
  --cl-bg-0: #040711;      /* 极夜近黑（画面顶部） */
  --cl-bg-1: #061324;      /* 夜雾 */
  --cl-bg-2: #0b2436;      /* 冰蓝（画面底部） */
  --cl-aurora-1: #3ef0a8;  /* 极光绿 */
  --cl-aurora-2: #52ccff;  /* 冰蓝 */
  --cl-aurora-3: #a06bff;  /* 极光紫 */
  --cl-ice: #e6f6ff;       /* 冰白 */
  --cl-ink:  #eaf4ff;
  --cl-ink-2: rgba(234, 244, 255, .78);
  --cl-ink-3: rgba(234, 244, 255, .55);
  --cl-serif: 'EB Garamond', 'Noto Serif SC', 'Songti SC', serif;
  --cl-sans: 'PingFang SC', 'Microsoft YaHei', sans-serif;

  position: relative;
  min-height: 100vh;
  background:
    radial-gradient(140% 40% at 50% 64%, rgba(62, 240, 168, .26) 0%, rgba(62, 240, 168, 0) 60%),
    radial-gradient(125% 36% at 50% 104%, rgba(120, 210, 255, .26) 0%, rgba(120, 210, 255, 0) 64%),
    linear-gradient(to bottom, var(--cl-bg-0) 0%, var(--cl-bg-1) 44%, var(--cl-bg-2) 100%);
  color: var(--cl-ink);
  font-family: var(--cl-sans);
  overflow-x: hidden;
}

/* ---------- WebGL 画布 ---------- */
.cl-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  display: block;
  width: 100%;
  height: 100%;
  /* 无 JS / WebGL 失败时画布透明，露出上面的 CSS 极夜渐变兜底 */
  background: transparent;
}
.cl.js-on .cl-canvas { background: var(--cl-bg-1); }

/* ---------- 顶部条（品牌 + 音乐钮，极简顶栏） ----------
   ⚠️ 2026-09-28：原来这里的 .cl-nav 四个导航已按要求删除。
   顶栏只剩「左品牌 + 右音乐钮」（.ld-top 那套样式随雨夜伦敦页一起删除了）。 */
.cl-top {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px clamp(20px, 3.4vw, 48px);
  pointer-events: none;
}
/* ⚠️ 顶栏容器本身不吃点击（免得挡住下面四幕的文字层），只放开真正的可点元素。
   音乐钮是 <button>（不在 <a> 里），必须单独放开 —— 漏掉它圆钮就点不动。 */
.cl-top a,
.cl-top button,
.cl-top .pf-music { pointer-events: auto; }
.cl-top-spacer { flex: 1 1 auto; }
.cl-brand {
  display: inline-flex;
  align-items: baseline;
  gap: 10px;
  color: var(--cl-ink);
  text-decoration: none;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: .06em;
}
.cl-brand span {
  font-size: 9.5px;
  font-weight: 400;
  letter-spacing: .34em;
  color: var(--cl-ink-3);
}

/* ---------- 音乐钮的令牌补齐（极地页专用） ----------
   .pf-music / .pf-snd 的样式在 profile.css 里（两页共用，保证观感一致），
   但那套 --pf-* 令牌是定义在 `.pf`（原「雨夜伦敦」页的根元素）上的 ——
   该页 2026-09-29 已删除，`.pf` 不再出现在 DOM 里：本页的根是 `.cl`，
   一个令牌都取不到 —— 而 var() 解析失败会让**整条简写**
   退回初始值，圆钮的描边（border: 1px solid var(--pf-line-1)）会直接消失。
   所以在这里补一份同名令牌，**取值与 profile.css 逐字相同**：
   观感与个人主页上那颗按钮一致。
   想让它跟极光主题走，只改 --pf-lamp / --pf-lamp-soft / --pf-lamp-faint
   三行（例如换成极光绿 #3ef0a8 / #2ec98c / rgba(62,240,168,.10)）。 */
.cl {
  --pf-lamp:        #E8A85C;
  --pf-lamp-soft:   #C98B47;
  --pf-lamp-faint:  rgba(232, 168, 92, .09);
  --pf-text-3:      #6B7685;
  --pf-text-4:      #454E5B;
  --pf-line-1:      rgba(168, 178, 191, .16);
  --pf-ease:        cubic-bezier(.22, .61, .36, 1);
}

/* ---------- 滚动文字层 ----------
   默认（无 JS）：文档流，四幕各一屏，可正常滚动阅读。
   js-on：fixed 叠层，opacity/transform 全部由 clouds.js 驱动。 */
.cl-copy { position: relative; z-index: 2; }

.cl-sec {
  position: relative;
  min-height: 100vh;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 clamp(24px, 7vw, 110px);
  pointer-events: auto;
}
.cl.js-on .cl-copy {
  position: fixed;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}
.cl.js-on .cl-sec {
  position: absolute;
  inset: 0;
  min-height: 0;
  display: flex;
  will-change: opacity, transform;
}
/* 各幕的对位（首幕居中；二、三幕「右中间」；照片幕 i=3..6；
   末幕 i=7「Say hi」联系幕「左中间」）。
   用 data-i 属性选择器 —— 幕数和顺序由 clouds.yml 驱动，不写死类名。

   ⚠️ .cl-sec 是 flex-direction: column —— 在 column 容器上
   justify-content 管的是**纵向**、align-items 才是**横向**。
   此前二、三幕写成 justify-content: flex-end（本意「靠右」，
   是 row 的思路），实际效果是「把文字压到屏幕下沿」，
   于是文字沉在底部。
   2026-09-28 按要求改为左中间：纵向居中（justify-content: center）
   + 横向靠左（align-items: flex-start）+ 文字左对齐。
   2026-09-29 末幕（联系幕）也改为左中间。
   2026-09-29 再按要求把**第二、三幕移到了右边**：纵向位置不动，
   仅横向改为靠右（align-items: flex-end）+ 文字右对齐。
   2026-09-29 v6b：幕序改为「三幕文字 → 四幕照片（i=3..6）→ Say hi（i=7）」
   —— 用户要求 Say hi 在最后一页；照片幕（v6c 起）由 84% 容器在
   flex 里居中，对位规格见下方照片幕区块。
   左右留白由 .cl-sec 的 padding 决定（clamp(24px, 7vw, 110px)，左右对称），
   所以靠右时的右边留白 = 原来靠左时的左边留白，视觉重量一致。 */
.cl-sec[data-i="0"] { align-items: center; text-align: center; }
/* 第二、三幕：右中间 —— 纵向居中不变（.cl.js-on 下仍是 justify-content:center），
   只把横向靠右（align-items: flex-end）+ 文字右对齐。 */
.cl-sec[data-i="1"],
.cl-sec[data-i="2"] { align-items: flex-end; text-align: right; }
/* 末幕（i=7 · Say hi 联系幕）：左中间 —— 竖线与条目列都必须靠左才成立。 */
.cl-sec[data-i="7"] { align-items: flex-start; text-align: left; }
.cl.js-on .cl-sec[data-i="1"],
.cl.js-on .cl-sec[data-i="2"],
.cl.js-on .cl-sec[data-i="7"] { justify-content: center; }

/* ---------- 第一幕 · 大标题 ---------- */
.cl-title {
  margin: 0;
  /* Miama：欧式古典手写体（见文件顶部 @font-face）。
     后面接原衬线栈兜底 —— 字体没下下来也不会塌成无衬线。 */
  font-family: 'Miama', var(--cl-serif);
  font-weight: 400;
  /* Miama 的 x-height 很小、升降部又极长，同样「视觉一大把」需要
     字号放到原衬线的约 1.45 倍、行距反而收到 1.0（字体自带大量上下空隙）。
     回退字体（EB Garamond）在这个尺寸也不会溢出——已按 6 视口量过。 */
  font-size: clamp(33px, 7.6vw, 138px);
  line-height: 1.0;
  letter-spacing: 0;
  color: var(--cl-ink);
  text-shadow: 0 2px 22px rgba(2, 10, 22, .7);
}
.cl-title span { display: block; }

/* ---------- 第二幕 · MESSAGE ---------- */
.cl-label {
  margin: 0 0 18px;
  font-family: var(--cl-serif);
  font-size: clamp(20px, 2.1vw, 30px);
  font-weight: 400;
  letter-spacing: .12em;
  color: var(--cl-ink);
}
.cl-text {
  margin: 0;
  max-width: 34em;
  font-size: clamp(14px, 1.25vw, 17px);
  line-height: 1.9;
  color: var(--cl-ink-2);
}
.cl-quote {
  margin: 26px 0 0;
  font-size: clamp(14px, 1.2vw, 16.5px);
  line-height: 1.85;
  color: var(--cl-ink-2);
}
.cl-quote b {
  font-weight: 600;
  color: var(--cl-ink);
  margin-right: 10px;
}

/* ---------- 第三 / 四幕 ---------- */
.cl-head {
  margin: 0;
  font-size: clamp(22px, 2.5vw, 36px);
  font-weight: 600;
  letter-spacing: .04em;
  color: var(--cl-ink);
  text-shadow: 0 1px 16px rgba(2, 10, 22, .6);
}
.cl-sub {
  margin: 16px 0 0;
  max-width: 30em;
  font-size: clamp(13.5px, 1.15vw, 16px);
  line-height: 1.9;
  color: var(--cl-ink-2);
}
.cl-links {
  margin-top: 34px;
  display: flex;
  gap: 14px;
}
.cl-btn, .cl-ghost {
  display: inline-block;
  padding: 12px 26px;
  border-radius: 999px;
  font-size: 13px;
  letter-spacing: .12em;
  text-decoration: none;
  transition: transform .25s ease, background .25s ease, color .25s ease,
              border-color .25s ease, box-shadow .25s ease;
}
.cl-btn {
  background: var(--cl-ice);
  color: #04121f;
}
.cl-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 26px rgba(120, 210, 255, .32);
}
.cl-ghost {
  border: 1px solid rgba(230, 246, 255, .38);
  color: var(--cl-ink);
}
.cl-ghost:hover {
  border-color: var(--cl-aurora-2);
  color: var(--cl-ice);
  transform: translateY(-2px);
}

/* ---------- 第四幕 · 联系（形态参照 AnHeYu 个人主页的 contact 幕）----------
   结构：大标题 → 一句 desc → 一道左竖线挑起的联系条目列
   （条目 hover 时 1px 下划线自左向右划出）。
   ⚠️ 本幕已按「左中间」对位（同二、三幕）：横向靠左 + 纵向居中。
   .cl-contact 用 block + max-width(46em) 限宽、块内文字左对齐，
   竖线因此贴着条目列左侧，与参考站一致。 */
.cl-contact {
  display: block;
  text-align: left;
  max-width: min(100%, 46em);
}
.cl-contact-title {
  margin: 0;
  font-family: var(--cl-serif);
  font-size: clamp(32px, 4.4vw, 62px);
  font-weight: 400;
  line-height: 1.12;
  letter-spacing: .01em;
  color: var(--cl-ink);
  text-shadow: 0 2px 22px rgba(2, 10, 22, .7);
  /* 参考站用 text-indent: -0.08em 把字形左缘推出去一点，
     让标题与下方竖线/条目左缘视觉对齐 */
  text-indent: -.06em;
}
.cl-contact-desc {
  margin: clamp(14px, 1.6vw, 22px) 0 0;
  font-size: clamp(13px, 1.15vw, 16px);
  letter-spacing: .05em;
  color: var(--cl-ink-2);
}
.cl-contact-cols { margin-top: clamp(30px, 4.2vw, 56px); }
.cl-contact-col {
  position: relative;
  padding-left: clamp(16px, 1.5vw, 22px);
}
/* 左竖线：冰蓝 → 收淡，比纯白更贴本页配色；两端各内收 3px */
.cl-contact-col::before {
  content: "";
  position: absolute;
  left: 0;
  top: 3px;
  width: 2px;
  height: calc(100% - 6px);
  border-radius: 2px;
  background: linear-gradient(180deg,
              var(--cl-ice) 0%,
              rgba(150, 200, 255, .45) 58%,
              rgba(150, 200, 255, .06) 100%);
}
.cl-contact-col-title {
  margin-bottom: 12px;
  text-transform: uppercase;
  font-size: clamp(10px, .78vw, 11.5px);
  letter-spacing: .22em;
  color: var(--cl-ink-2);
  opacity: .75;
}
.cl-contact-list { margin: 0; padding: 0; list-style: none; }
.cl-contact-item {
  font-size: clamp(13px, 1.1vw, 15.5px);
  line-height: 1.6;
  letter-spacing: .04em;
}
.cl-contact-item + .cl-contact-item { margin-top: clamp(8px, .9vw, 12px); }
.cl-contact-item a {
  display: inline-block;
  position: relative;
  color: var(--cl-ink);
  text-decoration: none;
  transition: color .22s ease;
}
/* 下划线初始为 scaleX(0)，hover 自左向右划出（参考站动效） */
.cl-contact-item a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 1px;
  background: currentColor;
  transform-origin: 0 0;
  transform: scale3d(0, 1, 1);
  transition: transform .18s linear;
}
.cl-contact-item a:hover { color: var(--cl-ice); }
.cl-contact-item a:hover::after { transform: scale3d(1, 1, 1); }
/* 前缀（「邮箱：」「GitHub：」）压暗一档，条目值更跳出来 */
.cl-contact-key { opacity: .62; }

/* ---------- 第四~七幕 · 照片（v6 新增；v6c 严格照抄 AnHeYu featured 规格）----------
   规格逐项取自 index.anheyu.com 的实测与 index.css 源码
   （2026-09-29 1440×900 无头实测：图 960×540 r25 / 盒 360×min202 /
   盒右缘=容器右缘 / 盒下缘探出图 60px / 主标 21.6px bold /
   副标 12.6px / 箭头 18px），DOM 与参考站一一对应：

     .cl-photo-item  = .featured-item + #featured-items-container
                       （width 84% 居中，≤1280: 90%；em 基准 18px）
     .cl-photo       = .featured-item-image（1088×612，≤1440: 960×540，
                       ≤1280: width 100%；bg #000，radius 25px，overflow hidden）
     .cl-featured    = .featured-item-context（absolute right:0 bottom:-60px，
                       420×min236 padding 50px 30px bg #040404；
                       ≤1440: 360×min202 padding 40px 26px；
                       ≤1280: 铺满图片、透明底，文字直接压图上）
     主标题 desc      = 1.2em/1.3 bold，margin-bottom 2.5em
     副标题 client    = absolute left/right 30 bottom 34，0.7em，字距 .05em，
                       右侧 padding 2em 给箭头让位
     箭头 svg         = absolute right 30 bottom 34，1em×1em，fill #fff
     遮罩 mask        = #fff（参考站原色：白条扫过揭示）

   ⚠️ 参考站的图片微倾斜（rotate -1deg + scale 1.05）是 .featured-item-link
   的 **hover** 态 —— 本页照片按要求无链接，基态不做倾斜。
   ⚠️ 按要求照片与标签**不含任何超链接**（ejs 不渲染 <a>）。
   幕的淡入淡出仍由 clouds.js 的 applyCopy 统一驱动（交叉淡变）。 */

/* 照片幕对位：84% 容器自带居中，撤掉 .cl-sec 的左右 padding */
.cl-sec[data-i="3"], .cl-sec[data-i="4"],
.cl-sec[data-i="5"], .cl-sec[data-i="6"] { padding: 0; }

.cl-photo-item {
  position: relative;
  width: 84%;
  /* 底部 60px 补偿：标签盒向下探出图片 60px，把它的一半让给上方，
     整组（图 + 探出的盒）在视口里才是真居中 */
  margin: 0 auto 60px;
  font-size: 18px;   /* 参考站 featured 的 em 基准（body 15px × #featured 1.2em） */
}
.cl-photo {
  position: relative;
  width: 1088px;
  height: 612px;
  max-width: 100%;
  margin: 0;
  background: #000;      /* 图未载入时的底（参考站同为纯黑） */
  border-radius: 25px;   /* 参考站 computed 实测值 */
  overflow: hidden;
}
.cl-photo-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}

/* featured 标签盒（= .featured-item-context）：压在图片右下角、向下探出 60px */
.cl-featured {
  position: absolute;
  right: 0;
  bottom: -60px;
  z-index: 2;
  box-sizing: border-box;
  width: 420px;
  min-height: 236px;
  padding: 50px 30px;
  background: #040404;
  text-align: justify;
  will-change: transform;   /* clouds.js 每帧写轻视差 translate3d */
}
.cl-featured-desc {
  font-family: var(--cl-serif);
  font-size: 1.2em;          /* 21.6px @18px 基准，与参考站一致 */
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0;
  margin: 0 0 2.5em;         /* 54px —— 给底部副标题 + 箭头留位 */
  color: #fff;
}
.cl-featured-client {
  position: absolute;
  left: 30px;
  right: 30px;
  bottom: 34px;
  padding-right: 2em;        /* 箭头让位（参考站同款） */
  font-size: .7em;           /* 12.6px */
  font-weight: 400;
  letter-spacing: .05em;
  line-height: 1.5;
  text-align: left;
  color: #eeeeff;
}
.cl-featured-arrow {
  position: absolute;
  right: 30px;
  bottom: 34px;
  width: 1em;                /* 18px */
  height: 1em;
  margin: 0;
  fill: #fff;
  transition: transform .25s ease-in-out;
}

/* ---------- split-line 逐行遮罩揭示（参考站动效）----------
   行内结构：.split-line > 文字 + .split-line-mask。
   · 无 JS（渐进增强）：遮罩默认已滑开（105%），文字直接可读；
   · js-on 且幕未浮现：遮罩盖住（0）；
   · 幕浮现过半（clouds.js 给幕加 .is-in）：遮罩滑出到 105%，
     文字像被「擦出来」一样逐行显现 —— 遮罩为参考站原色 #fff（白条扫过），
     副标题行比主标题行晚 .15s 起步，做出参考站的逐行节奏。 */
.split-line {
  position: relative;
  display: inline-block;
  margin-bottom: 2px;
  vertical-align: bottom;
  overflow: hidden;
}
.split-line-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  background: #fff;   /* 参考站原色 */
  transform: translate3d(105%, 0, 0);
}
.cl.js-on .cl-sec .split-line-mask {
  transform: translate3d(0, 0, 0);
  transition: transform .8s cubic-bezier(.77, 0, .175, 1);
}
.cl.js-on .cl-sec.is-in .split-line-mask {
  transform: translate3d(105%, 0, 0);
}
.cl.js-on .cl-sec.is-in .cl-featured-client .split-line-mask {
  transition-delay: .15s;
}

/* 参考站断点：≤1440 缩一档；≤1280 标签铺满图片（透明底压图）；
   ≤420/≤400 缩小 em 基准（0.8em / 0.65em） */
@media (max-width: 1440px) {
  .cl-photo { width: 960px; height: 540px; }
  .cl-featured { width: 360px; min-height: 202px; padding: 40px 26px; }
}
@media (max-width: 1280px) {
  .cl-photo-item { width: 90%; margin-bottom: 0; }
  .cl-photo { width: 100%; }
  .cl-featured {
    right: auto;
    left: 0;
    top: 0;
    bottom: auto;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 35px 30px;
    background: transparent;
  }
  .cl-featured-client { left: 0; bottom: 0; padding: 30px 30px; }
}
@media (max-width: 420px) {
  .cl-photo-item { font-size: 14.4px; }
}
@media (max-width: 400px) {
  .cl-photo-item { font-size: 11.7px; }
}

/* ---------- 滚动引导（左下竖排） ---------- */
.cl-guide {
  position: fixed;
  left: clamp(18px, 2.6vw, 40px);
  bottom: 30px;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  color: var(--cl-ink-2);
  transition: opacity .6s ease;
}
.cl-guide-txt {
  writing-mode: vertical-rl;
  font-size: 11px;
  letter-spacing: .3em;
  color: var(--cl-ink-3);
}
.cl-guide-arrow { animation: cl-guide-drop 2.2s ease-in-out infinite; }
@keyframes cl-guide-drop {
  0%, 100% { transform: translateY(0); opacity: .55; }
  55%      { transform: translateY(10px); opacity: 1; }
}
.cl.gone-guide .cl-guide { opacity: 0; pointer-events: none; }

/* ---------- 自定义滚动指示条（右侧） ---------- */
.cl-bar {
  position: fixed;
  right: 14px;
  top: 12vh;
  bottom: 12vh;
  width: 2px;
  z-index: 5;
  background: rgba(230, 246, 255, .12);
  border-radius: 2px;
  opacity: 0;
  transition: opacity .6s ease;
}
.cl.js-on .cl-bar { opacity: 1; }
.cl-bar-in {
  display: block;
  width: 100%;
  height: 18%;
  border-radius: 2px;
  background: var(--cl-ice);
  transform: translateY(0);
  will-change: transform;
}

/* ---------- 入场闸门 ----------
   默认 display:none（渐进增强）；js-on / cl-gate-on 后显示。
   进入 = 整块向上滑出（translateY(-101%)），露出 3D 场景。 */
.cl-gate {
  display: none;
}
/* ⚠️ 两个触发源，缺一不可（2026-09-30）：
   · html.cl-gate-on —— head 里的内联探针在**首帧之前**挂上，让闸门第一
     时间出现；否则要等 body 末尾的 clouds.js（three.js 之后）加 .js-on，
     中间那几百毫秒~1s 正文会按文档流先画出来，视觉上就是「正文先露脸、
     闸门后才盖上来」。clouds.js 接管时会摘掉它，只留 .js-on 一个来源。
   · .cl.js-on —— clouds.js 的模式开关；无 JS / 无 WebGL 时两者都不存在，
     页面保持文档流兜底，可用。 */
html.cl-gate-on { overflow: hidden; }   /* 闸门期不让正文冒出滚动条 */
.cl.js-on .cl-gate,
html.cl-gate-on .cl-gate {
  position: fixed;
  inset: 0;
  z-index: 9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26px;
  background:
    radial-gradient(140% 40% at 50% 64%, rgba(62, 240, 168, .16) 0%, rgba(62, 240, 168, 0) 60%),
    var(--cl-bg-0);
  cursor: pointer;
  transition: transform 1s cubic-bezier(.7, 0, .25, 1), opacity .9s ease;
  will-change: transform, opacity;
}
.cl.js-on .cl-gate.is-done {
  transform: translateY(-101%);
  opacity: .2;
  pointer-events: none;
}
.cl-gate-track {
  width: min(300px, 60vw);
  height: 3px;
  background: rgba(230, 246, 255, .14);
  border-radius: 3px;
  overflow: hidden;
}
.cl-gate-fill {
  display: block;
  width: 0%;
  height: 100%;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--cl-aurora-1), var(--cl-aurora-2) 52%, var(--cl-aurora-3));
  transition: width .3s ease;
}
/* ---------- 入场闸门：像素小猪（Nyan Pig）加载动画 ----------
   2026-09-30 按用户要求替换原来的 bouncing-bars 跳动条。
   来源：微信公众号「前端嘛」《彩虹屁猪猪 Loading 动画（源代码）》——
   像素风纯 SVG rect 拼块 + 各部位独立 CSS 动画（彩虹拖尾波浪、鼻子抽动、
   尾巴摆动、四脚漂浮、周期眨眼），零外部资源（不引字体、不引图片）。

   适配改动（原版是整屏 CodePen demo，这里是塞进闸门的小元素）：
     · 原版全局选择器 svg{...} 收成 .cl-gate-pig，避免污染全站 SVG；
     · 所有 @keyframes 加 cl-pig- 前缀，避免与主题已有动画重名；
     · 去掉原版的星空背景层 / Press Start 2P 字体 / "Loading..." 文字
       （闸门外面本来就是极光星空；且按要求不再显示任何提示文字）；
     · 渐变 id 改 cl-pig-rainbow；彩虹左端渐隐的 mask 由 #0a0916 换 #000
       （mask 只认 alpha 通道，颜色值无所谓）；
     · 上下浮动 20px → 14px（原版按整屏比例给的，这里收一点更精致）。

   换肤：把 svg 上的 nyan 换成 devil / alien / baguette —— 原版四套皮肤，
   猪身与彩虹同时换色（变量见下面 .cl-gate-pig.* 四组）。 */
.cl-gate-pig {
  --pig-speed: .4s;
  width: min(280px, 62vw);
  height: auto;
  -webkit-mask-image: linear-gradient(to left, #000 62%, transparent 88%);
  mask-image: linear-gradient(to left, #000 62%, transparent 88%);
  animation: cl-pig-jagger var(--pig-speed) ease-in-out infinite alternate;
}
@keyframes cl-pig-jagger {
  to { transform: translateY(14px); }
}

/* 彩虹拖尾：6 段 rect 共用一条 6 色纵向渐变，起跳时刻逐段错开 → 波浪流动 */
.cl-gate-pig .rainbow rect {
  width: 5px;
  height: 6px;
  stroke: transparent;
  fill: url(#cl-pig-rainbow);
}
.cl-gate-pig .rainbow rect:nth-child(1) { transform: translate(25px, 8.4px);    animation: cl-pig-rainbow-1 var(--pig-speed) ease-in-out .0667s infinite alternate; }
.cl-gate-pig .rainbow rect:nth-child(2) { transform: translate(20.2px, 8.3px);  animation: cl-pig-rainbow-2 var(--pig-speed) ease-in-out .1333s infinite alternate; }
.cl-gate-pig .rainbow rect:nth-child(3) { transform: translate(15.4px, 8.2px);  animation: cl-pig-rainbow-3 var(--pig-speed) ease-in-out .2s    infinite alternate; }
.cl-gate-pig .rainbow rect:nth-child(4) { transform: translate(10.6px, 8.1px);  animation: cl-pig-rainbow-4 var(--pig-speed) ease-in-out .2667s infinite alternate; }
.cl-gate-pig .rainbow rect:nth-child(5) { transform: translate(5.8px, 8px);     animation: cl-pig-rainbow-5 var(--pig-speed) ease-in-out .3333s infinite alternate; }
.cl-gate-pig .rainbow rect:nth-child(6) { transform: translate(1px, 7.9px);     animation: cl-pig-rainbow-6 var(--pig-speed) ease-in-out .4s    infinite alternate; }
@keyframes cl-pig-rainbow-1 { to { transform: translate(25px, 9.0667px); } }
@keyframes cl-pig-rainbow-2 { to { transform: translate(20.2px, 9.6333px); } }
@keyframes cl-pig-rainbow-3 { to { transform: translate(15.4px, 10.2px); } }
@keyframes cl-pig-rainbow-4 { to { transform: translate(10.6px, 10.7667px); } }
@keyframes cl-pig-rainbow-5 { to { transform: translate(5.8px, 11.3333px); } }
@keyframes cl-pig-rainbow-6 { to { transform: translate(1px, 11.9px); } }

/* 四套皮肤（原版同款）：猪身 + 彩虹拖尾同时换色 */
.cl-gate-pig.nyan {
  --body1: #f19183; --body2: #fcd8d7; --stains: #fac4b8; --eyes: #0c0b0b;
  --ears: #f19183; --snout1: #f79197; --snout2: #f66b79; --snout-holes: #e73b36;
}
.cl-gate-pig.devil {
  --body1: #410a07; --body2: #bb1626; --stains: #790813; --eyes: #f0d459;
  --ears: #2b1d05; --snout1: #db2839; --snout2: #ae1f2d; --snout-holes: #900f0b;
}
.cl-gate-pig.alien {
  --body1: #116423; --body2: #15a031; --stains: #0f8b27; --eyes: #ffffff;
  --ears: #3dbc56; --snout1: #3dbc56; --snout2: #319e47; --snout-holes: #196e2a;
}
.cl-gate-pig.baguette {
  --body1: #f89f39; --body2: #fdb85a; --stains: #fedda7; --eyes: #0c0b0b;
  --ears: #dc790f; --snout1: #ffdea1; --snout2: #fedea2; --snout-holes: #f98d0e;
}
.cl-gate-pig.nyan     .rainbow-color1 { stop-color: #e12523; }
.cl-gate-pig.nyan     .rainbow-color2 { stop-color: #dc8d30; }
.cl-gate-pig.nyan     .rainbow-color3 { stop-color: #deeb44; }
.cl-gate-pig.nyan     .rainbow-color4 { stop-color: #01eb3e; }
.cl-gate-pig.nyan     .rainbow-color5 { stop-color: #138fe9; }
.cl-gate-pig.nyan     .rainbow-color6 { stop-color: #7127ee; }
.cl-gate-pig.devil    .rainbow-color1 { stop-color: #d71440; }
.cl-gate-pig.devil    .rainbow-color2 { stop-color: #ff6c40; }
.cl-gate-pig.devil    .rainbow-color3 { stop-color: #ffce21; }
.cl-gate-pig.devil    .rainbow-color4 { stop-color: #ffce21; }
.cl-gate-pig.devil    .rainbow-color5 { stop-color: #ff6c40; }
.cl-gate-pig.devil    .rainbow-color6 { stop-color: #d71440; }
.cl-gate-pig.alien    .rainbow-color1 { stop-color: #12a921; }
.cl-gate-pig.alien    .rainbow-color2 { stop-color: #0fce22; }
.cl-gate-pig.alien    .rainbow-color3 { stop-color: #0fef25; }
.cl-gate-pig.alien    .rainbow-color4 { stop-color: #0fef25; }
.cl-gate-pig.alien    .rainbow-color5 { stop-color: #0fce22; }
.cl-gate-pig.alien    .rainbow-color6 { stop-color: #12a921; }
.cl-gate-pig.baguette .rainbow-color1 { stop-color: #2465de; }
.cl-gate-pig.baguette .rainbow-color2 { stop-color: #2465de; }
.cl-gate-pig.baguette .rainbow-color3 { stop-color: #ffffff; }
.cl-gate-pig.baguette .rainbow-color4 { stop-color: #ffffff; }
.cl-gate-pig.baguette .rainbow-color5 { stop-color: #f1200d; }
.cl-gate-pig.baguette .rainbow-color6 { stop-color: #f1200d; }

/* 猪身各部位 */
.cl-gate-pig .pig { transform: translate(-29px); }
.cl-gate-pig .pig .body1,
.cl-gate-pig .tail rect,
.cl-gate-pig .foot rect { fill: var(--body1); }
.cl-gate-pig .pig .body2 { fill: var(--body2); }
.cl-gate-pig .stains { fill: var(--stains); }

/* 猪鼻：2s 一轮，抽两下鼻子（左右各 0.5 个用户单位） */
.cl-gate-pig .snout {
  stroke: transparent;
  transform: translate(52px);
  animation: cl-pig-sniff 2s ease-in-out infinite;
}
.cl-gate-pig .snout .snout1 { fill: var(--snout1); }
.cl-gate-pig .snout .snout2 { fill: var(--snout2); }
.cl-gate-pig .snout .snout-holes { fill: var(--snout-holes); }
@keyframes cl-pig-sniff {
  5%, 15%, 25%  { transform: translate(52px); }
  10%, 20%      { transform: translate(52.5px); }
}

/* 卷尾巴摆动 */
.cl-gate-pig .tail {
  transform: translate(52.25px);
  transform-origin: center;
}
.cl-gate-pig .tail rect:nth-child(2) {
  transform: translate(3.25px, 10.5px);
  animation: cl-pig-tail var(--pig-speed) ease-in-out infinite alternate;
}
@keyframes cl-pig-tail {
  to { transform: translate(3.25px, 10px); }
}

/* 四只脚划水 */
.cl-gate-pig .foot {
  transform: translate(52px);
  animation: cl-pig-foot var(--pig-speed) ease-in-out infinite alternate;
}
@keyframes cl-pig-foot {
  to { transform: translate(52.5px); }
}

.cl-gate-pig .ears rect { fill: var(--ears); }

/* 眨眼：step-start 让透明度「瞬跳」，2s 一次 */
.cl-gate-pig .eyes { transform: translate(52px); }
.cl-gate-pig .eyes rect {
  fill: var(--eyes);
  animation: cl-pig-blink 2s step-start infinite;
}
@keyframes cl-pig-blink {
  5%  { opacity: 1; }
  10% { opacity: 0; }
}

/* LOADING... 闪烁文字（原版 .loader-text + @keyframes loader-text-blink）：
   夹在小猪与进度条中间，0.4s 交替闪烁。
   字体用原版同款 **Press Start 2P** 像素字，自托管在 /fonts/press-start-2p/
   （latin 子集 12KB，@font-face 在文件顶部，许可见同目录 LICENSE.txt）。
   ⚠️ 三条「别动」：不要加 letter-spacing（自带等距字距，加了会破坏像素
      栅格，字会忽宽忽窄）；不要加 font-weight 加粗（只有一个字重，合成
      加粗会让像素边缘发虚）；不要加 text-shadow（同理糊边）。 */
.cl-gate-loading {
  font-family: 'Press Start 2P', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 16px;      /* 8 的整数倍：每格正好 2 物理像素（dpr=2 时 4px） */
  line-height: 1;
  text-transform: uppercase;
  color: rgba(230, 246, 255, .95);
  user-select: none;
  animation: cl-pig-loading-blink .4s ease-in-out infinite alternate;
}
@keyframes cl-pig-loading-blink {
  from { opacity: .12; }
  to   { opacity: 1; }
}

/* ---------- 虚拟滚动锁 ---------- */
body.cl-lock { overflow: hidden; }

/* ---------- 响应式 ---------- */
@media (max-width: 860px) {
  /* .cl-nav 已删除（2026-09-28 取消此页导航），这里只剩品牌副标的收敛 */
  .cl-brand span { display: none; }
  /* 二、三幕靠右、第四幕靠左的对位由主样式表统一规定，窄屏同样成立，
     这里不再另做覆盖。只保留第三幕链接的居中。 */
  .cl-links { justify-content: center; }
  .cl-bar { right: 8px; }
  /* 照片幕（v6c）：断点行为全部由照片幕区块的 1440/1280/420/400
     断点接管（与参考站一致），窄屏这里不再另有覆盖 */
}

/* ---------- 动效降级 ---------- */
@media (prefers-reduced-motion: reduce) {
  .cl-guide-arrow { animation: none; }
  /* 小猪整套动画（含彩虹波浪、抽鼻、眨眼）在减弱动效下全部停住 */
  .cl-gate-pig,
  .cl-gate-pig * { animation: none !important; }
  /* LOADING... 同理停闪，但保持常亮可读 */
  .cl-gate-loading { animation: none; opacity: 1; }
  .cl.js-on .cl-gate { transition: opacity .6s ease; }
}

/* ---------- 全页文字不可选取（2026-09-29 按要求）----------
   长按鼠标左键拖拽选不中任何文字，观感对齐 AnHeYu 的个人主页。

   实现：
     · 作用域取 body.cl-body（本页 body 的类，见 layout/page.ejs；
       页面地址是 /profile/，类名沿用 cl-body）——
       比 `.cl` 更彻底：闸门、顶栏、搜索弹层这些不在 .cl 里的节点也覆盖到，
       同时不碰站点 header/footer 与文章页。
     · ⚠️ user-select 在规范里**不是继承属性**，但浏览器把父级的 none
       当「默认值」往下传；只有当页面里某处显式写了 user-select:text/all
       才会破功。所以这里再用 `*` 把整棵子树压一遍，避免主题里
       （如 .post-content、代码块的 .gutter）那类写法漏进来。
     · ⚠️ 不要用 pointer-events:none 代替 —— 那会让链接点不动、
       音乐钮失效；user-select 只影响"选中"这一个行为，点击/悬停不受影响，
       左键按下依然会触发猫张嘴。
     · 三段前缀（-webkit-/-moz-/-ms-）是为了 Safari/Firefox/旧 Edge，
       现代 Chrome 只认无前缀那条也照样生效。
   ⚠️ 输入型控件（若以后往此页加）保留正常选择：宁可漏一点，
      也别让输入框里的文字没法选中复制。 */
body.cl-body,
body.cl-body * {
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

/* 关掉移动端长按弹出的系统菜单/放大镜（桌面端无副作用） */
body.cl-body {
  -webkit-touch-callout: none;
}

/* 兜底：个别浏览器在 border/伪元素上仍可能拖出选中框，
   把选中底色刷成透明，视觉上同样"选不中"（不含输入控件）。 */
body.cl-body *:not(input):not(textarea)::selection {
  background: transparent;
  color: inherit;
}

body.cl-body input,
body.cl-body textarea,
body.cl-body [contenteditable] {
  -webkit-user-select: text;
  -moz-user-select: text;
  user-select: text;
}
