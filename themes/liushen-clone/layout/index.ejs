<%- partial('_partial/head', { page, config, theme }) %>
<body>
  <div class="scroll-progress" id="scroll-progress"></div>
  <%- partial('_partial/header', { page, config, theme }) %>
  <%- partial('_partial/search-dialog') %>

  <main class="site-body container">

    <!-- Hero -->
    <section class="hero">
      <%- partial('_partial/hero-badge', { theme }) %>
      <div class="hero-main">
        <img class="hero-avatar" src="<%= url_for(theme.avatar || '/img/avatar.jpg') %>" alt="avatar" onerror="this.style.display='none'">
        <div class="hero-text">
          <h1 class="hero-title">Shang Qian's blog</h1>
          <p class="hero-desc">欲买桂花同载酒，终不似，少年游。</p>
        </div>
      </div>
      <div class="hero-meta">
        <span class="hero-author">作者 <a href="<%= theme.social && theme.social.github ? theme.social.github : '#' %>" target="_blank" rel="noopener"><%= config.author %></a></span>
        <div class="hero-social">
          <% if (theme.social && theme.social.github) { %><a href="<%= theme.social.github %>" target="_blank" rel="noopener" title="GitHub"><i class="fa-brands fa-github"></i></a><% } %>
          <% if (theme.social && theme.social.email) { %><a href="<%= theme.social.email %>" title="邮箱"><i class="fa-solid fa-envelope"></i></a><% } %>
          <% if (theme.social && theme.social.qq) { %><a href="<%= theme.social.qq %>" target="_blank" rel="noopener" title="QQ"><i class="fa-brands fa-qq"></i></a><% } %>
        </div>
      </div>
    </section>

    <!-- 内容区 -->
    <div class="layout-grid">
      <div class="main-col">
        <div class="post-list">
          <% page.posts.each(function (article) { %>
            <%- partial('_partial/post-card', { article: article }) %>
          <% }); %>
        </div>

        <% if (page.prev || page.next) { %>
        <nav class="pagination">
          <% if (page.prev) { %><a class="page-link prev" href="<%= url_for(page.prev_link) %>"><i class="fa-solid fa-angle-left"></i> 上一页</a><% } %>
          <span class="page-info"><%= page.current %> / <%= page.total %></span>
          <% if (page.next) { %><a class="page-link next" href="<%= url_for(page.next_link) %>">下一页 <i class="fa-solid fa-angle-right"></i></a><% } %>
        </nav>
        <% } %>
      </div>

      <%- partial('_partial/aside', { page, config, theme }) %>
    </div>
  </main>

  <%- partial('_partial/footer', { config, theme }) %>
  <button class="back-top" id="back-top" aria-label="回到顶部">
    <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 4l8 8h-5v8h-6v-8H4z"/></svg>
  </button>
  <%- partial('_partial/body-end') %>
  <script src="<%= url_for('/js/main.js') %>"></script>
</body>
</html>
