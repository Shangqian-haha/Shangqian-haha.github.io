<%- partial('_partial/head', { page, config, theme }) %>
<body>
  <div class="scroll-progress" id="scroll-progress"></div>
  <%- partial('_partial/header', { page, config, theme }) %>
  <%- partial('_partial/search-dialog') %>

  <main class="site-body container">
    <%- partial('_partial/hero-badge', { theme }) %>
    <header class="list-header card">
      <h1 class="list-title"><i class="fa-regular fa-folder-open"></i> 分类</h1>
      <% if (page.category) { %>
        <p class="list-sub">分类「<%= page.category %>」共 <%= page.posts.length %> 篇文章</p>
      <% } else { %>
        <p class="list-sub">共 <%= site.categories.length %> 个分类</p>
      <% } %>
    </header>

    <% if (!page.category) { %>
      <div class="taxonomy-list">
        <% site.categories.each(function (c) { %>
          <a class="taxonomy-item card" href="<%= url_for(c.path) %>">
            <span class="taxonomy-name"><%= c.name %></span>
            <span class="taxonomy-count"><%= c.posts.length %> 篇</span>
          </a>
        <% }); %>
      </div>
    <% } %>

    <div class="post-list">
      <% page.posts.each(function (article) { %>
        <%- partial('_partial/post-card', { article: article }) %>
      <% }); %>
    </div>
  </main>

  <%- partial('_partial/footer', { config, theme }) %>
  <button class="back-top" id="back-top" aria-label="回到顶部">
    <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 4l8 8h-5v8h-6v-8H4z"/></svg>
  </button>
  <%- partial('_partial/body-end') %>
  <script src="<%= url_for('/js/main.js') %>"></script>
</body>
</html>
