<!DOCTYPE html>
<html lang="zh-CN" class="no-js">
<head>
<meta charset="utf-8">
<script>
  /* 在首次绘制前把 no-js 换成 js —— 让 CSS 能区分"脚本可用 / 不可用"。
     必须内联且尽早，否则会出现"先按 no-js 渲染、再跳变"的闪烁。 */
  document.documentElement.className = document.documentElement.className.replace(/\bno-js\b/, 'js');
</script>
<% /* ---------- 入场闸门：抢在首帧就出现（2026-09-30 修） ----------
     症状：进 /profile/ 先看到正文「Welcome to Shang Qian's Blog」，约 1s
     后闸门才盖上来。
     原因：.cl-gate 默认 display:none，只有 body 末尾的 clouds.js 跑完 WebGL
     检测、给 .cl 挂上 .js-on 才显示；而这段脚本要等 three.r112.js（几百 KB）
     解析完才执行，期间第一幕已按文档流绘制 —— 于是「正文先露脸」。
     修法：把「要不要显示闸门」的判断提前到这里的**内联阻塞脚本**（首帧前
     执行），只做一次极廉价的 WebGL 能力探针，通过就给 <html> 挂
     .cl-gate-on；clouds.css 里该选择器与 .cl.js-on 共用同一套闸门样式。
       · 无 JS   → 脚本不跑，不加类 → 保持「文档流兜底」的原设计
       · 无 WebGL → 探针失败，不加类 → 同样兜底
       · clouds.js 一旦接管会置 window.__clBooted，12s 内没接管就自动摘掉
         该类（three.js 加载失败等），绝不把访客困在闸门里。 */ %>
<% if (page.type === 'clouds') { %>
<script>
  (function () {
    var ok = false;
    try {
      var c = document.createElement('canvas');
      ok = !!(c.getContext('webgl') || c.getContext('experimental-webgl'));
    } catch (e) { ok = false; }
    if (!ok) return;
    var h = document.documentElement;
    h.classList.add('cl-gate-on');
    /* ⚠️ 兜底时限 12s（2026-09-30 由 6s 放宽）：实测 200KB/s 弱网下
       three.r112.js 下载 + 解析 + WebGL 初始化要 6~10s，6s 兜底会先把
       闸门摘掉、让正文裸奔好几秒、闸门又盖回来 —— 比卡住更难看。
       12s 已远超真实设备的脚本就绪时间；真正「永远卡住」的场景
       （脚本加载失败）由 clouds.js 自己的 bootFail() 即时摘除。 */
    window.setTimeout(function () {
      if (!window.__clBooted) {
        h.classList.remove('cl-gate-on');
        if (document.body) document.body.classList.remove('cl-lock');
      }
    }, 12000);
  })();
</script>
<% } %>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#17191f">
<meta name="color-scheme" content="dark light">
<%
  var _title = config.title;
  if (is_post()) _title = page.title + ' · ' + config.title;
  else if (!is_home() && page.title) _title = page.title + ' · ' + config.title;
%>
<title><%= _title %></title>
<meta name="description" content="<%= page.description || theme.description || config.description || '' %>">
<meta name="generator" content="Hexo">
<link rel="icon" href="<%= url_for(theme.avatar || '/img/avatar.jpg') %>">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css">
<link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
<% /* ⚠️ 必须带版本查询串。hexo server 对静态资源不发 Cache-Control / ETag /
      Last-Modified，Chrome 会对这条 CSS 做启发式缓存 —— 改完刷新也看不到，
      只有硬刷新才生效。（踩过：首页标题上移调了四五次都没生效，就是这个原因。）
      v 用 Date.now()：开发时保证每次渲染都是新 URL。 */ %>
<% if (is_home()) { %><link rel="stylesheet" href="<%= url_for('/css/home-hero.css') %>?v=<%= Date.now() %>"><% } %>
<% /* 全屏叙事页：2026-09-29 起站内只剩 /profile/（极地 · 极光冰原）。
       原 /profile/ 的「雨夜伦敦」页已按要求删除，资产备份在
       .workbuddy/removed-profile-london-20260929/。
       共用 profile.css 的字体与 .pf-body 基底（profile.css 这个名字虽然叫
       profile，其实是两页/一页共用的基底，别删）；clouds.css 在 profile.css
       **之后**加载，它自带 --cl-* 命名空间色板，不做变量重置
       （那是 v1 时代的做法，v2 起已废弃）。 */ %>
<% if (page.type === 'clouds') { %>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@5.0.0/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/eb-garamond@5.0.0/index.css">
<link rel="stylesheet" href="<%= url_for('/css/profile.css') %>?v=<%= Date.now() %>">
<link rel="stylesheet" href="<%= url_for('/css/clouds.css') %>?v=<%= Date.now() %>">
<% } %>
<% /* 404 · 雪夜：圣诞老人舔烟囱（原生 Canvas 版，绘图逻辑见 js/santa404.js）。
       样式与脚本都只在这一页加载。 */ %>
<% if (page.type === '404') { %>
<link rel="stylesheet" href="<%= url_for('/css/santa404.css') %>?v=<%= Date.now() %>">
<% } %>
<% /* 打嗝猫鼠标指针：全站生效（含 /profile/）。
      CSS 定普通态/按住左键的两张 PNG；JS 负责按下时给 <html> 挂 cat-click。 */ %>
<link rel="stylesheet" href="<%= url_for('/css/cursor-cat.css') %>?v=<%= Date.now() %>">
<script defer src="<%= url_for('/js/cursor-cat.js') %>?v=<%= Date.now() %>"></script>
<script>
  // 首次绘制前设置主题，避免闪烁
  (function () {
    var saved = null;
    try { saved = localStorage.getItem('theme'); } catch (e) {}
    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = saved || 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
</head>
