<% /*
  ============ /profile/ · 极地 · 极光冰原 · v5「Aurora」 ============

  ⚠️ 2026-09-29 路由迁移：本页原挂在 /clouds/（标题「云海之上」）；原 /profile/ 的
     「雨夜伦敦」页按要求删除后，本页改挂到 /profile/，导航「个人主页」也指向这里。
     内部命名保持 clouds（type: clouds、clouds.css/js/ejs、clouds.yml）—— 因为
     profile.css 这个名字被**共用基底**占着（字体 / .pf-body / 音乐控件），改名会撞名；
     所以只改路由与注释，不做大面积重命名（避免回归风险）。老路径 /clouds/ 不再生成；
     雨夜伦敦页资产备份在 .workbuddy/removed-profile-london-20260929/。

  纯自研 three.js r112 场景，**零外部模型/贴图**（贴图用 canvas 现画）：
    · 极夜雾 + 星空 + 极光幕（合并几何 + 自写 shader，帘脚青绿→帘顶紫粉）
    · 冰脊剪影三层（多频正弦山脊 + 雪线高光）+ 冰原 + 冰面倒影 + 雪粒
    · 虚拟滚动：滚轮/触摸/键盘 → 目标值 → 缓动；
      滚动越快，极光越亮、雪越急（boost）
    · 四幕滚动叙事：**纯风景，全靠相机运动叙事**
      （仰视穹顶 → 右移侧看 → 升高俯瞰冰原 → 拉远全景）
    · 入场闸门：进度条 → 点击任意处 → 上滑揭开

  ⚠️ 渐进增强（本项目踩过「CSS 默认隐藏 → 脚本没跑整页空白」的坑）：
    · 闸门 .cl-gate 默认 display:none，只有 .cl.js-on 下才显示
      （js-on 由 clouds.js 第一时间加；无 JS 时页面 = 纯 CSS 极夜渐变 + 全部文字，可用）
    · 所有文字层默认可见，JS 只负责随滚动切换，不在服务端隐藏任何一幕

  备份：v1 绘画化云海 → .workbuddy/clouds-v1-backup/
        v2 霓虹隧道奔跑者 → .workbuddy/clouds-v2-backup/
  内容数据在 source/_data/clouds.yml（文件名沿用 clouds，见上方路由说明）。

  v6（2026-09-29）：新增四幕照片幕（AnHeYu 式 featured 标签），
  八幕滚动；照片与标签不含任何超链接。
  v6b（2026-09-29）：幕序改为「三幕文字 → 照片幕 i=3..6 → Say hi i=7（最后一页）」；
  照片改卡片式（不铺满，深色底 + 大圆角卡片 + 标签盒压右下角探出）。
  v6c（2026-09-29）：照片幕几何**严格照抄** AnHeYu featured 规格
  （84% 容器 / 960×540 图 r25 / 标签盒 right:0 bottom:-60px /
  主标 1.2em bold / 副标 0.7em / 白色遮罩 / ≤1280 标签铺图），见 clouds.css。
*/ %>
<%
  var _d      = site.data.clouds || {};
  var brand   = _d.brand      || '尚谦';
  var brandSub= _d.brand_sub  || 'SHANG QIAN';
  var _gate   = _d.gate || {};
  var gateLoad  = _gate.loading || '正在生成极光';
  var gateAudio = _gate.audio   || '正在缓冲音乐';
  var gateEnter = _gate.enter   || '点击任意处进入';
  var guideTxt  = _d.guide || '滚动查看更多';
  var _secs   = _d.secs || [];
  /* 音乐配置读 source/_data/profile.yml 的 music 段 ——
     与 js/music.js、profile.css 的 .pf-music 组成共用模块，改一处即生效。 */
  var _music  = (site.data.profile || {}).music || {};
%>
<div class="cl" id="clouds-root">

  <!-- 顶部条：品牌 + 音乐钮。
       ⚠️ 2026-09-28 按要求取消此页右上角的四个导航（clouds.yml 的 nav 段也已
          删除），顶栏只留「左品牌 + 右音乐钮」。
          本站其它入口由站点 header 与各幕内的链接承担。 -->
  <header class="cl-top">
    <a class="cl-brand" href="/"><%= brand %><span><%= brandSub %></span></a>

    <span class="cl-top-spacer"></span>

    <% /* 音乐控件：组件与样式都在共用模块里（js/music.js + profile.css 的
          .pf-music / .pf-snd），本页零专属样式。 */ %>
    <% if (_music.enabled !== false) { %>
    <div class="pf-music" id="pf-music"
         data-src="<%= _music.src || '' %>"
         data-type="<%= _music.type || 'audio/mpeg' %>"
         data-volume="<%= _music.volume != null ? _music.volume : 0.20 %>"
         data-loop="<%= _music.loop !== false ? '1' : '0' %>"
         data-title="<%= _music.title || 'Untitled' %>">
      <button class="pf-snd" id="pf-music-btn" type="button"
              aria-label="播放背景音乐" aria-pressed="false" title="播放背景音乐">
        <canvas class="pf-snd-canvas" id="pf-snd-canvas" width="20" height="20" aria-hidden="true"></canvas>
      </button>
    </div>
    <% } %>
  </header>

  <!-- WebGL 画布（three r112：极光幕 / 星空 / 冰脊 / 冰原 / 倒影 / 雪） -->
  <canvas class="cl-canvas" id="cl-canvas" aria-hidden="true"></canvas>

  <!-- 滚动文字层：四幕，由 clouds.js 按 scroll 进度驱动 -->
  <div class="cl-copy" id="cl-copy">
    <% _secs.forEach(function (s) { %>
    <section class="cl-sec" data-i="<%= s.i || 0 %>">
      <% if (s.title) { %>
      <h1 class="cl-title">
        <% String(s.title).replace(/\r/g, '').split('\n').forEach(function (line) {
             if (String(line).trim()) { %><span><%= line %></span><% }
           }); %>
      </h1>
      <% } %>
      <% if (s.label) { %><h3 class="cl-label"><%= s.label %></h3><% } %>
      <% if (s.text) { %><p class="cl-text"><%= s.text %></p><% } %>
      <% if (s.quote) { %>
      <p class="cl-quote"><b>「<%= s.quote_from || '' %>」</b><%= s.quote %></p>
      <% } %>
      <% if (s.head) { %><h3 class="cl-head"><%= s.head %></h3><% } %>
      <% if (s.sub) { %><p class="cl-sub"><%= s.sub %></p><% } %>
      <% /* 联系幕（末幕）：形态参照 AnHeYu 个人主页的 contact 幕 ——
            大标题 + 一句 desc + 左侧一道竖线挑起的条目列。
            条目在 clouds.yml 的 sec.contact.items 里配置。 */ %>
      <% if (s.contact) { var _ct = s.contact; %>
      <div class="cl-contact">
        <% if (_ct.title) { %><h3 class="cl-contact-title"><%= _ct.title %></h3><% } %>
        <% if (_ct.desc) { %><p class="cl-contact-desc"><%= _ct.desc %></p><% } %>
        <div class="cl-contact-cols">
          <div class="cl-contact-col">
            <% if (_ct.col_title) { %><div class="cl-contact-col-title"><%= _ct.col_title %></div><% } %>
            <ul class="cl-contact-list">
              <% (_ct.items || []).forEach(function (it) { %>
              <li class="cl-contact-item">
                <a href="<%= it.href || '#' %>"<% if (/^https?:/i.test(String(it.href || ''))) { %> target="_blank" rel="noopener noreferrer"<% } %>><% if (it.label) { %><span class="cl-contact-key"><%= it.label %></span>：<% } %><%= it.value %></a>
              </li>
              <% }); %>
            </ul>
          </div>
        </div>
      </div>
      <% } %>
      <% /* 照片幕（v6 新增；v6c 严格照抄 AnHeYu featured 规格）：
            DOM 结构与参考站一一对应：
              .cl-photo-item  = .featured-item + #featured-items-container
                                （84% 容器、relative 定位基准、em 基准 18px）
              .cl-photo       = .featured-item-image（1088×612 / ≤1440: 960×540）
              .cl-featured    = .featured-item-context
                                （right:0 bottom:-60px 黑盒，≤1280 铺图透明底）
            desc/client 各包一层 .split-line（行内一枚**白色** .split-line-mask，
            幕浮现过半时向右滑出揭示 —— 参考站同款，副标行晚 .15s）；
            一枚同款 SVG 箭头（absolute right30 bottom34）。
            按用户要求**不含任何超链接**（参考站的 .featured-item-link 不做）。
            无 JS 时遮罩默认已滑开（渐进增强，文字可读）。 */ %>
      <% if (s.photo) { var _ph = s.photo; %>
      <div class="cl-photo-item">
        <figure class="cl-photo">
          <img class="cl-photo-img" src="<%= _ph.src %>" alt="<%= _ph.alt || '' %>" draggable="false">
        </figure>
        <div class="cl-featured">
          <div class="cl-featured-desc split-line-mask-effect">
            <div class="split-line"><%= _ph.title || '' %><span class="split-line-mask" aria-hidden="true"></span></div>
          </div>
          <div class="cl-featured-client split-line-mask-effect">
            <div class="split-line"><%= _ph.sub || '' %><span class="split-line-mask" aria-hidden="true"></span></div>
          </div>
          <svg class="cl-featured-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8" aria-hidden="true"><polygon points="6.767 0.603 6.767 5.897 0.871 0 0 0.872 5.894 6.767 0.605 6.767 0.605 8 8 8 8 0.603 6.767 0.603"></polygon></svg>
        </div>
      </div>
      <% } %>
      <% if (s.links && s.links.length) { %>
      <div class="cl-links">
        <% s.links.forEach(function (l) { %>
        <a class="<%= l.style === 'ghost' ? 'cl-ghost' : 'cl-btn' %>" href="<%= l.href %>"><%= l.label %></a>
        <% }); %>
      </div>
      <% } %>
    </section>
    <% }); %>
  </div>

  <!-- 滚动引导（左下竖排，进入正文后隐藏） -->
  <div class="cl-guide" id="cl-guide">
    <span class="cl-guide-txt"><%= guideTxt %></span>
    <svg class="cl-guide-arrow" width="5" height="40" viewBox="0 0 5 40" aria-hidden="true">
      <path d="M0,40V0H1V35H5Z" fill="currentColor"></path>
    </svg>
  </div>

  <!-- 自定义滚动指示条（右侧） -->
  <div class="cl-bar" aria-hidden="true"><i class="cl-bar-in" id="cl-bar"></i></div>

  <!-- 入场闸门：默认 display:none；两种情形下显示 ——
       ① html.cl-gate-on：head 里的内联探针在首帧前挂上，让闸门第一时间
          出现（否则正文会先按文档流画出来，约 1s 后闸门才盖上来）；
       ② .cl.js-on：clouds.js 接管后的正式开关。
       ⚠️ 闸门内**不再显示任何提示文字**（2026-09-30 按要求取消，原来是
          「正在生成极光 / 正在缓冲音乐 / 点击任意处进入」三句）。
          下面的 data-enter / data-audio 两个属性仍然保留（clouds.yml 里
          也还有对应配置项），clouds.js 的 setHint() 找不到 hint 元素会
          自动空转；想恢复文字，在进度条后面加回
          <span class="cl-gate-hint" id="cl-gate-hint"></span> 并补回 CSS。 -->
  <div class="cl-gate" id="cl-gate" data-enter="<%= gateEnter %>" data-audio="<%= gateAudio %>">
    <!-- 像素小猪加载动画（Nyan Pig）—— 2026-09-30 按用户要求替换原来的
         bouncing-bars 跳动条。纯 SVG rect 拼块，无任何外部资源。
         样式与换肤开关见 clouds.css 的 .cl-gate-pig 段（svg 上换类名即可
         切 nyan / devil / alien / baguette 四套皮肤）。 -->
    <svg class="cl-gate-pig nyan" xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 47 20" aria-hidden="true">
      <defs>
        <linearGradient id="cl-pig-rainbow" x1="0.5" x2="0.5" y2="1">
          <stop class="rainbow-color1" offset="0"></stop>
          <stop class="rainbow-color1" offset="0.167"></stop>
          <stop class="rainbow-color2" offset="0.167"></stop>
          <stop class="rainbow-color2" offset="0.335"></stop>
          <stop class="rainbow-color3" offset="0.335"></stop>
          <stop class="rainbow-color3" offset="0.5"></stop>
          <stop class="rainbow-color4" offset="0.5"></stop>
          <stop class="rainbow-color4" offset="0.669"></stop>
          <stop class="rainbow-color5" offset="0.669"></stop>
          <stop class="rainbow-color5" offset="0.833"></stop>
          <stop class="rainbow-color6" offset="0.833"></stop>
          <stop class="rainbow-color6" offset="1"></stop>
        </linearGradient>
      </defs>
      <g class="rainbow">
        <rect></rect><rect></rect><rect></rect>
        <rect></rect><rect></rect><rect></rect>
      </g>
      <g class="pig">
        <g class="foot">
          <rect width="1" height="3" transform="translate(6 13)"></rect>
          <rect width="1" height="3" transform="translate(8 13)"></rect>
          <rect width="1" height="3" transform="translate(14 13)"></rect>
          <rect width="1" height="3" transform="translate(12 13)"></rect>
        </g>
        <g class="tail">
          <rect width="1" height="1" transform="translate(4 10)"></rect>
          <rect width="1" height="1" transform="translate(3 11)"></rect>
        </g>
        <g transform="translate(52)">
          <rect class="body1" width="8" height="8" transform="translate(7 6)"></rect>
          <rect class="body1" width="10" height="8" transform="translate(6 7)"></rect>
          <rect class="body1" width="12" height="6" transform="translate(5 8)"></rect>
          <rect class="body2" width="10" height="6" transform="translate(6 8)"></rect>
          <rect class="body2" width="8" height="6" transform="translate(7 7)"></rect>
          <rect class="stains" width="4" height="1" transform="translate(7 13)"></rect>
          <rect class="stains" width="2" height="1" transform="translate(8 12)"></rect>
          <rect class="stains" width="2" height="1" transform="translate(6 9)"></rect>
          <rect class="stains" width="3" height="1" transform="translate(6 8)"></rect>
          <rect class="stains" width="3" height="1" transform="translate(7 7)"></rect>
          <rect class="stains" width="1" height="1" transform="translate(14 7)"></rect>
        </g>
        <g class="ears" transform="translate(52)">
          <rect width="1" height="3" transform="translate(10 5)"></rect>
          <rect width="1" height="3" transform="translate(15 5)"></rect>
        </g>
        <g class="snout">
          <rect class="snout1" width="5" height="3" transform="translate(13 10)"></rect>
          <rect class="snout-holes" width="1" height="3" transform="translate(17 11) rotate(90)"></rect>
          <rect class="snout2" width="1" height="1" transform="translate(16 11) rotate(90)"></rect>
        </g>
        <g class="eyes">
          <rect width="1" height="1" transform="translate(12 9)"></rect>
          <rect width="1" height="1" transform="translate(15 9)"></rect>
        </g>
      </g>
    </svg>

    <!-- LOADING... 闪烁文字（原版 .loader-text），夹在小猪与进度条中间。
         原版依赖 Google Fonts 的 Press Start 2P 像素字体，这里不引外部字体
         （国内访问不稳 + 会阻塞首屏），改用系统等宽栈近似，见 clouds.css。 -->
    <span class="cl-gate-loading" aria-hidden="true">Loading...</span>

    <div class="cl-gate-track"><i class="cl-gate-fill" id="cl-gate-fill"></i></div>
  </div>
</div>
